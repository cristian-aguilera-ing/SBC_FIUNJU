fiunju:Consejo_BD_Cartesiano a fiunju:TopicoDeConsejo,
        fiunju:TopicoErroresComunes ;
    rdfs:label "Cuidado con el Producto Cartesiano"@es ;
    fiunju:descripcion "Si olvidas el JOIN/WHERE, combinas todas las filas. Error grave que anula el ejercicio."@es ;
    owl:sameAs fiunju:Consejo_BD_Cartesiano .

fiunju:Consejo_BD_Profesional a fiunju:TopicoAplicacionProf,
        fiunju:TopicoDeConsejo ;
    rdfs:label "Valor en el Mercado"@es ;
    fiunju:descripcion "Normalización y SQL Avanzado son habilidades críticas para tu primer empleo IT."@es ;
    owl:sameAs fiunju:Consejo_BD_Profesional .

fiunju:Consejo_Fisica_Resiliencia a fiunju:TopicoDeConsejo,
        fiunju:TopicoFrustracion ;
    rdfs:label "Resistencia al 1er Parcial"@es ;
    fiunju:descripcion "Es normal desaprobar el primero. La mayoría regulariza en recuperatorio."@es ;
    owl:sameAs fiunju:Consejo_Fisica_Resiliencia .

fiunju:Consejo_Fisica_Unidades a fiunju:TopicoDeConsejo,
        fiunju:TopicoErroresComunes ;
    rdfs:label "Trampa de Unidades"@es ;
    fiunju:descripcion "El error #1 es mezclar sistemas. Pasa siempre todo al Sistema Internacional."@es ;
    owl:sameAs fiunju:Consejo_Fisica_Unidades .

fiunju:Consejo_Intro_Logica a fiunju:TopicoDeConsejo,
        fiunju:TopicoMochilaTecnica ;
    rdfs:label "Lógica antes de Código"@es ;
    fiunju:descripcion "Valoran más el pseudocódigo bien planteado que un programa que 'corre de casualidad'."@es ;
    owl:sameAs fiunju:Consejo_Intro_Logica .

fiunju:Consejo_MetProg_Grupo a fiunju:TopicoDeConsejo,
        fiunju:TopicoDinamicaSocial ;
    rdfs:label "El Equipo es Todo"@es ;
    fiunju:descripcion "Busca compañeros responsables YA. Cambiar de grupo a mitad de cuatrimestre es fatal."@es ;
    owl:sameAs fiunju:Consejo_MetProg_Grupo .

fiunju:Consejo_ProgCon_Error a fiunju:TopicoDeConsejo,
        fiunju:TopicoErroresComunes ;
    rdfs:label "La Trampa de los Hilos"@es ;
    fiunju:descripcion "Que corra bien una vez no significa que esté bien. Prueba múltiples ejecuciones."@es ;
    owl:sameAs fiunju:Consejo_ProgCon_Error .

fiunju:Consejo_ProgCon_HW a fiunju:TopicoDeConsejo,
        fiunju:TopicoRequisitoHardware ;
    rdfs:label "Entorno Java"@es ;
    fiunju:descripcion "Lleva notebook con Java+IDE a las prácticas para probar hilos en tiempo real."@es ;
    owl:sameAs fiunju:Consejo_ProgCon_HW .

fiunju:Consejo_ProgCon_Impacto a fiunju:TopicoDeConsejo,
        fiunju:TopicoImpactoEstrategico ;
    rdfs:label "Prioridad Absoluta"@es ;
    fiunju:descripcion "Es el 'tapón' de la carrera. Bloquea materias de 3ro y 4to."@es ;
    owl:sameAs fiunju:Consejo_ProgCon_Impacto .

fiunju:Consejo_SistOp_Capilla a fiunju:TopicoDeConsejo,
        fiunju:TopicoExamenOral ;
    rdfs:label "Estrategia de Unidad Específica"@es ;
    fiunju:descripcion "Si rinden pocos, es Oral. Prepara un tema 'blindado' para iniciar."@es ;
    owl:sameAs fiunju:Consejo_SistOp_Capilla .

fiunju:Consejo_SistOp_Integral a fiunju:TopicoCriterioCorreccion,
        fiunju:TopicoDeConsejo ;
    rdfs:label "El 'Integral' Salvavidas"@es ;
    fiunju:descripcion "Existe una última instancia: un Examen Integral Teórico-Práctico al final."@es ;
    owl:sameAs fiunju:Consejo_SistOp_Integral .

fiunju:Consejo_SistOp_Libros a fiunju:TopicoDeConsejo,
        fiunju:TopicoFuentesInfo ;
    rdfs:label "Libros Obligatorios"@es ;
    fiunju:descripcion "Los apuntes no alcanzan. Apóyate en Stallings o Tanenbaum."@es ;
    owl:sameAs fiunju:Consejo_SistOp_Libros .

fiunju:Consejo_SistOp_Vidas a fiunju:TopicoDeConsejo,
        fiunju:TopicoValorClase ;
    rdfs:label "El Sistema de las '3 Vidas'"@es ;
    fiunju:descripcion "Toman cuestionarios con penalización al inicio de cada teórica. Si desapruebas 3, quedas LIBRE."@es ;
    owl:sameAs fiunju:Consejo_SistOp_Vidas .

fiunju:EstrategiaExamen_Atipico_A a fiunju:EstrategiaExamen,
        fiunju:EstrategiaRecomendacion ;
    fiunju:cantidadMaterias 2 ;
    fiunju:cantidadMinimaRequerida 1 ;
    fiunju:descripcionPlan "Plan A: 1 Muy Difícil + 1 Normal. (Condición obligatoria: busca un lugar tranquilo para estudiar y dedicate a estudiar todo el tiempo que puedas)."@es ;
    fiunju:ordenPrioridad 1 ;
    fiunju:requiereDificultadExamen fiunju:ExamenMuyDificil ;
    owl:sameAs fiunju:EstrategiaExamen_Atipico_A .

