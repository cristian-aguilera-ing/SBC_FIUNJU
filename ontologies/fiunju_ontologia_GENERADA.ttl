fiunju:ArquetipoEquilibrado a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "green" ;
    fiunju:tieneEstrategiaPosible fiunju:Est_Equilibrado_A,
        fiunju:Est_Equilibrado_B,
        fiunju:Est_Equilibrado_C,
        fiunju:Est_Equilibrado_D ;
    fiunju:tieneNombreArquetipo "El Equilibrado" ;
    owl:sameAs fiunju:ArquetipoEquilibrado .

fiunju:ArquetipoErmitano a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "blue" ;
    fiunju:tieneEstrategiaPosible fiunju:Est_Ermitano_A,
        fiunju:Est_Ermitano_B,
        fiunju:Est_Ermitano_C,
        fiunju:Est_Ermitano_D ;
    fiunju:tieneNombreArquetipo "El Ermitaño del Interior" ;
    owl:sameAs fiunju:ArquetipoErmitano .

fiunju:ArquetipoGuerrero a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "yellow" ;
    fiunju:tieneEstrategiaPosible fiunju:Est_Guerrero_A,
        fiunju:Est_Guerrero_B,
        fiunju:Est_Guerrero_C,
        fiunju:Est_Guerrero_D ;
    fiunju:tieneNombreArquetipo "El Guerrero Solitario" ;
    owl:sameAs fiunju:ArquetipoGuerrero .

fiunju:ArquetipoHeredero a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "violet" ;
    fiunju:tieneEstrategiaPosible fiunju:Est_Heredero_A,
        fiunju:Est_Heredero_B,
        fiunju:Est_Heredero_C,
        fiunju:Est_Heredero_D ;
    fiunju:tieneNombreArquetipo "El Heredero del Trono" ;
    owl:sameAs fiunju:ArquetipoHeredero .

fiunju:ArquetipoMalabarista a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "orange" ;
    fiunju:tieneEstrategiaPosible fiunju:Est_Malabarista_A,
        fiunju:Est_Malabarista_B,
        fiunju:Est_Malabarista_C,
        fiunju:Est_Malabarista_D ;
    fiunju:tieneNombreArquetipo "El Malabarista Urbano" ;
    owl:sameAs fiunju:ArquetipoMalabarista .

fiunju:ArquetipoPadreFullTime a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "brown" ;
    fiunju:tieneEstrategiaPosible fiunju:Est_Equilibrado_A,
        fiunju:Est_Equilibrado_B,
        fiunju:Est_Equilibrado_C,
        fiunju:Est_Equilibrado_D ;
    fiunju:tieneNombreArquetipo "El Padre/Madre Full-Time" ;
    owl:sameAs fiunju:ArquetipoPadreFullTime .

fiunju:ArquetipoSuperviviente a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "red" ;
    fiunju:tieneConsejoBase "Usa Pomodoro." ;
    fiunju:tieneEstrategiaPosible fiunju:Est_Superviviente_A,
        fiunju:Est_Superviviente_B,
        fiunju:Est_Superviviente_C,
        fiunju:Est_Superviviente_D ;
    fiunju:tieneNombreArquetipo "El Superviviente" ;
    owl:sameAs fiunju:ArquetipoSuperviviente .

fiunju:MateriaDeAltoEsfuerzo rdfs:subClassOf fiunju:Materia ;
