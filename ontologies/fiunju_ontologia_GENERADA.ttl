    fiunju:cantidadMinimaRequerida 2 ;
    fiunju:descripcionPlan "Plan B: 2 Finales Difíciles. (No recomendado salvo que tengas el apoyo total por varios días en casa)."@es ;
    fiunju:ordenPrioridad 2 ;
