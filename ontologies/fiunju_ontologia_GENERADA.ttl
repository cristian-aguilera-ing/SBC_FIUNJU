@prefix fiunju: <http://fi.unju.edu.ar/ontologia/informatica#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fiunju:ArquetipoEstudiante a rdfs:Class ;
    owl:sameAs fiunju:ArquetipoEstudiante .

fiunju:EstrategiaExamen a rdfs:Class ;
    owl:sameAs fiunju:EstrategiaExamen .

fiunju:EstrategiaRecomendacion a rdfs:Class ;
    owl:sameAs fiunju:EstrategiaRecomendacion .

fiunju:ExamenMultipleChoice a rdfs:Class ;
    rdfs:label "Examen Multiple Choice"@es ;
    fiunju:tieneDificultadExamen fiunju:ExamenNormal ;
    rdfs:subClassOf fiunju:ModalidadExamenFinal ;
    owl:disjointWith fiunju:ExamenTeoricoEscrito,
        fiunju:ExamenTeoricoOral ;
    owl:sameAs fiunju:ExamenMultipleChoice .

fiunju:ExamenTeoricoEscrito a rdfs:Class ;
    rdfs:label "Examen Teórico Escrito"@es ;
    fiunju:tieneDificultadExamen fiunju:ExamenDificil ;
    rdfs:subClassOf fiunju:ModalidadExamenFinal ;
    owl:disjointWith fiunju:ExamenTeoricoOral ;
    owl:sameAs fiunju:ExamenTeoricoEscrito .

fiunju:ExamenTeoricoOral a rdfs:Class ;
    rdfs:label "Examen Teórico Oral"@es ;
    fiunju:tieneDificultadExamen fiunju:ExamenMuyDificil ;
    rdfs:subClassOf fiunju:ModalidadExamenFinal ;
    owl:sameAs fiunju:ExamenTeoricoOral .

fiunju:FactorAcademico a rdfs:Class ;
    owl:sameAs fiunju:FactorAcademico .

fiunju:FactorMentalidad a rdfs:Class ;
    owl:sameAs fiunju:FactorMentalidad .

fiunju:FactorPersonal a rdfs:Class ;
    owl:sameAs fiunju:FactorPersonal .

fiunju:FactorPlanificacion a rdfs:Class ;
    owl:sameAs fiunju:FactorPlanificacion .

fiunju:Materia a rdfs:Class ;
    owl:sameAs fiunju:Materia .

fiunju:ModalidadExamenFinal a rdfs:Class ;
    owl:sameAs fiunju:ModalidadExamenFinal .

fiunju:NivelDificultadCursada a rdfs:Class ;
    owl:sameAs fiunju:NivelDificultadCursada .

fiunju:NivelDificultadExamen a rdfs:Class ;
    owl:sameAs fiunju:NivelDificultadExamen .

fiunju:TopicoAplicacionProf a rdfs:Class ;
    rdfs:label "Aplicación Profesional"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoAplicacionProf .

fiunju:TopicoAprobacionTI a fiunju:TopicoDeConsejo,
        rdfs:Class ;
    rdfs:label "Trabajo Integrador"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoAprobacionTI .

fiunju:TopicoCriterioCorreccion a rdfs:Class ;
    rdfs:label "Criterio de Corrección"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoCriterioCorreccion .

fiunju:TopicoDeConsejo a rdfs:Class ;
    owl:sameAs fiunju:TopicoDeConsejo .

fiunju:TopicoDinamicaSocial a rdfs:Class ;
    rdfs:label "Dinámica de Grupo"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoDinamicaSocial .

fiunju:TopicoErroresComunes a rdfs:Class ;
    rdfs:label "Errores Clásicos"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoErroresComunes .

fiunju:TopicoExamenEscrito a rdfs:Class ;
    rdfs:label "Examen Escrito"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoExamenEscrito .

fiunju:TopicoExamenOral a rdfs:Class ;
    rdfs:label "Examen Oral"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoExamenOral .

fiunju:TopicoFrustracion a rdfs:Class ;
    rdfs:label "Resistencia y Mentalidad"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoFrustracion .

fiunju:TopicoFuentesInfo a rdfs:Class ;
    rdfs:label "Bibliografía vs Apuntes"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoFuentesInfo .

fiunju:TopicoGestionTiempo a rdfs:Class ;
    rdfs:label "Gestión del Tiempo"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoGestionTiempo .

fiunju:TopicoImpactoEstrategico a rdfs:Class ;
    rdfs:label "Impacto Estratégico"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoImpactoEstrategico .

fiunju:TopicoMochilaTecnica a rdfs:Class ;
    rdfs:label "Conocimiento Previo"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoMochilaTecnica .

fiunju:TopicoMultipleChoice a rdfs:Class ;
    rdfs:label "Multiple Choice"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoMultipleChoice .

fiunju:TopicoRequisitoHardware a rdfs:Class ;
    rdfs:label "Requisito de Hardware"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoRequisitoHardware .

fiunju:TopicoValorClase a rdfs:Class ;
    rdfs:label "Valor de la Clase"@es ;
    rdfs:subClassOf fiunju:TopicoDeConsejo ;
    owl:sameAs fiunju:TopicoValorClase .

fiunju:ArquetipoAtipico a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "brown"^^xsd:string ;
    fiunju:tieneConsejoClave "Cuidá tus tiempos, tomá buenas notas y mantente constante para no perder promoción. Practica con materiales de otros años. Prioriza materias troncales."@es ;
    fiunju:tieneEstrategiaExamen fiunju:EstrategiaExamen_Atipico_A,
        fiunju:EstrategiaExamen_Atipico_B ;
    fiunju:tieneEstrategiaPosible fiunju:Estrategia_Atipico_A,
        fiunju:Estrategia_Atipico_B,
        fiunju:Estrategia_Atipico_C,
        fiunju:Estrategia_Atipico_D ;
    fiunju:tieneNombreArquetipo "Perfil Atípico"@es ;
    fiunju:tieneTarjetaDiagnostico """Tiempo libre de trabajo, pero los hijos interrumpen el "flujo" de estudio constante.
* No trabajas
* Vivis en Capital
* No vivis solo
* Tenes hijo/s"""@es ;
    owl:sameAs fiunju:ArquetipoAtipico .

fiunju:ArquetipoBajo a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "orange"^^xsd:string ;
    fiunju:tieneConsejoClave "Balancea tus prioridades a las materias que querés cursar, procura que sea una materia con menor carga horaria y con parciales accesibles. Aprovecha tus tiempos libres, para estudiar en lugares tranquilos como la facultad."@es ;
    fiunju:tieneEstrategiaExamen fiunju:EstrategiaExamen_Bajo_A,
        fiunju:EstrategiaExamen_Bajo_B,
        fiunju:EstrategiaExamen_Bajo_C ;
    fiunju:tieneEstrategiaPosible fiunju:Estrategia_Bajo_A,
        fiunju:Estrategia_Bajo_B,
        fiunju:Estrategia_Bajo_C,
        fiunju:Estrategia_Bajo_D ;
    fiunju:tieneNombreArquetipo "Perfil Bajo"@es ;
    fiunju:tieneTarjetaDiagnostico """Tiene un poco más de tiempo gracias al apoyo familiar y vivir cerca.
* trabajas tiempo completo
* Vivis en Capital
* No vives solo
* tenes hijo/s"""@es ;
    owl:sameAs fiunju:ArquetipoBajo .

fiunju:ArquetipoCritico a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "red"^^xsd:string ;
    fiunju:tieneConsejoClave "Necesitas cursar muy pocas materias y priorizar las más fáciles. La perseverancia es clave."@es ;
    fiunju:tieneEstrategiaExamen fiunju:EstrategiaExamen_Critico_A,
        fiunju:EstrategiaExamen_Critico_B,
        fiunju:EstrategiaExamen_Critico_C ;
    fiunju:tieneEstrategiaPosible fiunju:Estrategia_Critico_A,
        fiunju:Estrategia_Critico_B,
        fiunju:Estrategia_Critico_C,
        fiunju:Estrategia_Critico_D ;
    fiunju:tieneNombreArquetipo "Perfil Crítico"@es ;
    fiunju:tieneTarjetaDiagnostico """Tu perfil tiene 'muy poco tiempo para estudiar'. No se permiten errores.
* trabajas tiempo completo
* Vivis lejos
* vivis solo
* tenes hijo/s"""@es ;
    owl:sameAs fiunju:ArquetipoCritico .

fiunju:ArquetipoEquilibrado a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "green"^^xsd:string ;
    fiunju:tieneConsejoClave "Prioriza las materias troncales, y organízate bien para no perder la promoción. Si no entiendes un tema, asiste a consultas. Estudiar en la facultad te ayuda a concentrarte más. Resuelve parciales de años anteriores."@es ;
    fiunju:tieneEstrategiaExamen fiunju:EstrategiaExamen_Equilibrado_A,
        fiunju:EstrategiaExamen_Equilibrado_B,
        fiunju:EstrategiaExamen_Equilibrado_C,
        fiunju:EstrategiaExamen_Equilibrado_D ;
    fiunju:tieneEstrategiaPosible fiunju:Estrategia_Equilibrado_A,
        fiunju:Estrategia_Equilibrado_B,
        fiunju:Estrategia_Equilibrado_C,
        fiunju:Estrategia_Equilibrado_D ;
    fiunju:tieneNombreArquetipo "Perfil Equilibrado"@es ;
    fiunju:tieneTarjetaDiagnostico """Es el balance perfecto. Puede asumir carga, pero no extrema.
* trabajas medio tiempo
* Vivis en Capital
* No vivis solo
* No tenes hijo/s"""@es ;
    owl:sameAs fiunju:ArquetipoEquilibrado .

fiunju:ArquetipoMedioAlto a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "blue"^^xsd:string ;
    fiunju:tieneConsejoClave "Prioriza todas las materias, y organízate bien para no perder la promoción. No descuides tus tiempos libres, aprovéchalos para estudiar. Tenés mucho tiempo de estudio, pero vivir solo y lejos igual consume horas. Organízate, práctica parciales y usá apuntes de compañeros."@es ;
    fiunju:tieneEstrategiaExamen fiunju:EstrategiaExamen_MedioAlto_A,
        fiunju:EstrategiaExamen_MedioAlto_B ;
    fiunju:tieneEstrategiaPosible fiunju:Estrategia_MedioAlto_A,
        fiunju:Estrategia_MedioAlto_B,
        fiunju:Estrategia_MedioAlto_C,
        fiunju:Estrategia_MedioAlto_D ;
    fiunju:tieneNombreArquetipo "Perfil Medio-Alto"@es ;
    fiunju:tieneTarjetaDiagnostico """Tiempo completo, pero vivir solo viene con tareas domésticas y viajar limita la "energía mental".
* No trabajas
* Vivis en el Interior
* Vivis solo
* No tenes hijo/s"""@es ;
    owl:sameAs fiunju:ArquetipoMedioAlto .

fiunju:ArquetipoMedioBajo a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "yellow"^^xsd:string ;
    fiunju:tieneConsejoClave "Prioriza las materias troncales, y organízate bien para no perder la promoción. Usá parciales de años anteriores y apuntes de compañeros."@es ;
    fiunju:tieneEstrategiaExamen fiunju:EstrategiaExamen_MedioBajo_A,
        fiunju:EstrategiaExamen_MedioBajo_B,
        fiunju:EstrategiaExamen_MedioBajo_C ;
    fiunju:tieneEstrategiaPosible fiunju:Estrategia_MedioBajo_A,
        fiunju:Estrategia_MedioBajo_B,
        fiunju:Estrategia_MedioBajo_C,
        fiunju:Estrategia_MedioBajo_D ;
    fiunju:tieneNombreArquetipo "Perfil Medio-Bajo"@es ;
    fiunju:tieneTarjetaDiagnostico """Tiene tiempo, pero viajar largas distancias más las tareas domésticas te quitan energía.
* trabajas medio tiempo
* Vivis en el Interior
* Vivis solo
* No tenes hijo/s"""@es ;
    owl:sameAs fiunju:ArquetipoMedioBajo .

fiunju:ArquetipoSuperAlto a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "violet"^^xsd:string ;
    fiunju:tieneConsejoClave "Tenés el perfil con más disponibilidad. Prioriza todas las materias, y organízate bien para no perder la promoción. No te quedes libre. No descuides tus tiempos libres, aprovechalos para estudiar hace apuntes de cada tema, para estar al día."@es ;
    fiunju:tieneEstrategiaExamen fiunju:EstrategiaExamen_SuperAlto_A,
        fiunju:EstrategiaExamen_SuperAlto_B,
        fiunju:EstrategiaExamen_SuperAlto_C ;
    fiunju:tieneEstrategiaPosible fiunju:Estrategia_SuperAlto_A,
        fiunju:Estrategia_SuperAlto_B,
        fiunju:Estrategia_SuperAlto_C,
        fiunju:Estrategia_SuperAlto_D ;
    fiunju:tieneNombreArquetipo "Perfil Super Alto"@es ;
    fiunju:tieneTarjetaDiagnostico """Disponibilidad total. Su única restricción es su propia capacidad de concentración.
* No trabajas
* Vivis en Capital
* No vivis solo
* No tenes hijo/s"""@es ;
    owl:sameAs fiunju:ArquetipoSuperAlto .

fiunju:FP_LugarResidencia a fiunju:FactorPersonal ;
    rdfs:label "Lugar de Residencia (Interior vs. Capital)"@es ;
    fiunju:tienePrioridad 4 ;
    owl:sameAs fiunju:FP_LugarResidencia .

fiunju:FP_SituacionHogar a fiunju:FactorPersonal ;
    rdfs:label "Situación de Hogar (vive solo, tiene hijos)"@es ;
    fiunju:tienePrioridad 2 ;
    owl:sameAs fiunju:FP_SituacionHogar .

fiunju:FP_TipoTrabajo a fiunju:FactorPersonal ;
    rdfs:label "El trabajo está relacionado con la informática"@es ;
    fiunju:tienePrioridad 3 ;
    owl:sameAs fiunju:FP_TipoTrabajo .

fiunju:FP_Trabaja a fiunju:FactorPersonal ;
    rdfs:label "Trabaja"@es ;
    fiunju:tienePrioridad 1 ;
    owl:sameAs fiunju:FP_Trabaja .

fiunju:InstanciaGeneral_Escrito a fiunju:TopicoDeConsejo,
        fiunju:TopicoExamenEscrito ;
    rdfs:label "Estrategia Final Escrito"@es ;
    fiunju:descripcion "Dedica 5 minutos a leer todo antes de empezar. Sé prolijo y justifica siempre tus respuestas teóricas."@es ;
    owl:sameAs fiunju:InstanciaGeneral_Escrito .

fiunju:InstanciaGeneral_Tiempo a fiunju:TopicoDeConsejo,
        fiunju:TopicoGestionTiempo ;
    rdfs:label "Administración Inteligente"@es ;
    fiunju:descripcion "Asignatura de alta carga horaria. Prioriza la práctica sobre la teoría pura si estás corto de tiempo. Intenta bloques de estudio de 40min con descansos."@es ;
    owl:sameAs fiunju:InstanciaGeneral_Tiempo .

