    rdfs:label "Material de Estudio"@es ;
    owl:sameAs fiunju:TopicoMaterialEstudio .

true a xsd:boolean ;
    owl:sameAs true .

270 a xsd:decimal,
        xsd:integer ;
    owl:sameAs 270 .

