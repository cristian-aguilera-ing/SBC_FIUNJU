fiunju:LegEticaProf a fiunju:Materia,
        fiunju:Obligatoria ;
    rdfs:label "Legislación, Etica y Ejercicio Profesional"@es ;
    fiunju:perteneceAlAño 5 ;
    fiunju:requiereCreditos 180 ;
    fiunju:tieneDificultadCursada fiunju:Nivel_4 ;
    fiunju:tieneModalidadExamen fiunju:ExamenTeoricoOral ;
    fiunju:tieneRequisito fiunju:NivAptIng,
        fiunju:NivSufIng ;
    owl:sameAs fiunju:LegEticaProf .

fiunju:MatDisc a fiunju:Materia,
        fiunju:Obligatoria ;
    rdfs:label "Matemática Discreta"@es ;
    fiunju:esRequisitoPara fiunju:SistInt ;
    fiunju:perteneceAlAño 2 ;
    fiunju:tieneDificultadCursada fiunju:Nivel_2 ;
    fiunju:tieneModalidadExamen fiunju:ExamenTeoricoEscrito ;
    fiunju:tieneRequisito fiunju:AlgebraLineal ;
    owl:sameAs fiunju:MatDisc .

fiunju:MateriaDeAltoEsfuerzo rdfs:subClassOf fiunju:Materia ;
    owl:sameAs fiunju:MateriaDeAltoEsfuerzo .

fiunju:TopicoAprobacionTI a fiunju:TopicoDeConsejo ;
    rdfs:label "Aprobación de Trabajos Integrador"@es ;
    owl:sameAs fiunju:TopicoAprobacionTI .

fiunju:TopicoExamenOral a fiunju:TopicoDeConsejo ;
    rdfs:label "Preparación para Examen Oral"@es ;
    owl:sameAs fiunju:TopicoExamenOral .

fiunju:comentarioExperto a owl:DatatypeProperty ;
    rdfs:subPropertyOf fiunju:comentarioExperto ;
    owl:equivalentProperty fiunju:comentarioExperto ;
    owl:sameAs fiunju:comentarioExperto .

fiunju:esMasDificilQue a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:subPropertyOf fiunju:esMasDificilQue ;
    owl:equivalentProperty fiunju:esMasDificilQue ;
    owl:sameAs fiunju:esMasDificilQue .

fiunju:otorgaCreditos a owl:DatatypeProperty ;
    rdfs:domain fiunju:Materia ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf fiunju:otorgaCreditos ;
    owl:equivalentProperty fiunju:otorgaCreditos ;
    owl:sameAs fiunju:otorgaCreditos .

fiunju:perteneceAlAño a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain fiunju:Materia,
        fiunju:Obligatoria ;
    rdfs:subPropertyOf fiunju:perteneceAlAño ;
    owl:equivalentProperty fiunju:perteneceAlAño ;
