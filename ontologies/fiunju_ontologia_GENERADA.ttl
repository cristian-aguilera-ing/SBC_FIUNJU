fiunju:ExamenDificil a fiunju:NivelDificultadExamen ;
    rdfs:label "Difícil"@es ;
    fiunju:tieneValor 3 ;
    owl:sameAs fiunju:ExamenDificil .

fiunju:ExamenMuyDificil a fiunju:NivelDificultadExamen ;
    rdfs:label "Muy Difícil"@es ;
    fiunju:tieneValor 4 ;
    owl:sameAs fiunju:ExamenMuyDificil .

fiunju:ExamenNormal a fiunju:NivelDificultadExamen ;
    rdfs:label "Normal"@es ;
    fiunju:tieneValor 2 ;
    owl:sameAs fiunju:ExamenNormal .

