    owl:sameAs fiunju:tieneNombreArquetipo .

fiunju:tieneRequisito a owl:ObjectProperty ;
    rdfs:subPropertyOf fiunju:tieneRequisito ;
    owl:equivalentProperty fiunju:tieneRequisito ;
    owl:inverseOf fiunju:esRequisitoPara ;
