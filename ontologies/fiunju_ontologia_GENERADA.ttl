fiunju:tieneDificultadExamen a owl:ObjectProperty ;
    rdfs:subPropertyOf fiunju:tieneDificultadExamen ;
    owl:equivalentProperty fiunju:tieneDificultadExamen ;
    owl:sameAs fiunju:tieneDificultadExamen .

fiunju:tieneModalidadExamen a owl:ObjectProperty ;
    rdfs:subPropertyOf fiunju:tieneModalidadExamen ;
    owl:equivalentProperty fiunju:tieneModalidadExamen ;
    owl:sameAs fiunju:tieneModalidadExamen .

fiunju:tieneNombreArquetipo a owl:DatatypeProperty ;
    rdfs:domain fiunju:ArquetipoEstudiante ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf fiunju:tieneNombreArquetipo ;
