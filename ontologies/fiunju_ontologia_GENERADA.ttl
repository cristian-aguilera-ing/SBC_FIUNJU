    owl:equivalentProperty fiunju:requiereCreditos ;
    owl:sameAs fiunju:requiereCreditos .

fiunju:requiereCuartoAnoAprobado a owl:DatatypeProperty ;
    rdfs:domain fiunju:Materia ;
