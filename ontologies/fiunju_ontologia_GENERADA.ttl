fiunju:tieneDificultadCursada a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:subPropertyOf fiunju:tieneDificultadCursada ;
    owl:equivalentProperty fiunju:tieneDificultadCursada ;
