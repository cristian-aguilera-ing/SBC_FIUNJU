    fiunju:cantidadMaterias 5 ;
    fiunju:cantidadMinimaRequerida 0 ;
    fiunju:descripcionPlan "Plan B: 5 Variadas. (Priorizá correlativas; no curses por cursar si no te traban la carrera)."@es ;
    fiunju:ordenPrioridad 2 ;
    owl:sameAs fiunju:Estrategia_SuperAlto_B .

fiunju:Estrategia_SuperAlto_C a fiunju:EstrategiaRecomendacion ;
    fiunju:cantidadMaterias 5 ;
    fiunju:cantidadMinimaRequerida 1 ;
    fiunju:descripcionPlan "Plan C: Solo Fáciles: Máximo permitido. (Usalo para subir promedio, pero no pierdas el hábito de estudio fuerte)."@es ;
    fiunju:ordenPrioridad 3 ;
    fiunju:requiereDisponibilidadDe fiunju:Nivel_1 ;
    owl:sameAs fiunju:Estrategia_SuperAlto_C .

fiunju:Estrategia_SuperAlto_D a fiunju:EstrategiaRecomendacion ;
    fiunju:cantidadMaterias 3 ;
    fiunju:cantidadMinimaRequerida 3 ;
    fiunju:descripcionPlan "Plan D: 3 Muy Difíciles. (Advertencia: Si procrastinas, perdés el cuatrimestre entero; requiere constancia)."@es ;
    fiunju:ordenPrioridad 4 ;
    fiunju:requiereDisponibilidadDe fiunju:Nivel_4 ;
    owl:sameAs fiunju:Estrategia_SuperAlto_D .

