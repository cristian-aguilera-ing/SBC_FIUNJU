### Classes and Properties
fiunju:EstrategiaRecomendacion a owl:Class ;
    rdfs:label "Estrategia de Recomendación"@es .

fiunju:ordenPrioridad a owl:DatatypeProperty ;
    rdfs:domain fiunju:EstrategiaRecomendacion ;
    rdfs:range xsd:integer .

fiunju:descripcionPlan a owl:DatatypeProperty ;
    rdfs:domain fiunju:EstrategiaRecomendacion ;
    rdfs:range xsd:string .

fiunju:cantidadMaterias a owl:DatatypeProperty ;
    rdfs:domain fiunju:EstrategiaRecomendacion ;
    rdfs:range xsd:integer .

fiunju:cantidadMinimaRequerida a owl:DatatypeProperty ;
    rdfs:domain fiunju:EstrategiaRecomendacion ;
    rdfs:range xsd:integer .

fiunju:requiereDisponibilidadDe a owl:ObjectProperty ;
    rdfs:domain fiunju:EstrategiaRecomendacion ;
    rdfs:range fiunju:NivelDificultadCursada .

fiunju:tieneEstrategiaPosible a owl:ObjectProperty ;
    rdfs:domain fiunju:ArquetipoEstudiante ;
    rdfs:range fiunju:EstrategiaRecomendacion .

### 1. Perfil Crítico
fiunju:ArquetipoCritico a fiunju:ArquetipoEstudiante ;
    fiunju:tieneNombreArquetipo "Perfil Crítico"@es ;
    fiunju:tieneColorIdentificativo "red" ;
    fiunju:tieneEstrategiaPosible fiunju:Estrategia_Critico_A, fiunju:Estrategia_Critico_B, fiunju:Estrategia_Critico_C, fiunju:Estrategia_Critico_D .

fiunju:Estrategia_Critico_A a fiunju:EstrategiaRecomendacion ;
    fiunju:ordenPrioridad 1 ;
    fiunju:descripcionPlan "Plan A: 2 Fáciles (Prioridad Alta)"@es ;
    fiunju:cantidadMaterias 2 ;
    fiunju:requiereDisponibilidadDe fiunju:Nivel_1 ;
    fiunju:cantidadMinimaRequerida 2 .

fiunju:Estrategia_Critico_B a fiunju:EstrategiaRecomendacion ;
    fiunju:ordenPrioridad 2 ;
    fiunju:descripcionPlan "Plan B: 1 Normal"@es ;
    fiunju:cantidadMaterias 1 ;
    fiunju:requiereDisponibilidadDe fiunju:Nivel_2 ;
    fiunju:cantidadMinimaRequerida 1 .

fiunju:Estrategia_Critico_C a fiunju:EstrategiaRecomendacion ;
    fiunju:ordenPrioridad 3 ;
    fiunju:descripcionPlan "Plan C: 1 Difícil"@es ;
    fiunju:cantidadMaterias 1 ;
    fiunju:requiereDisponibilidadDe fiunju:Nivel_3 ;
    fiunju:cantidadMinimaRequerida 1 .

fiunju:Estrategia_Critico_D a fiunju:EstrategiaRecomendacion ;
    fiunju:ordenPrioridad 4 ;
    fiunju:descripcionPlan "Plan D: 1 Muy Difícil (No recomendado, pero única opción)"@es ;
    fiunju:cantidadMaterias 1 ;
    fiunju:requiereDisponibilidadDe fiunju:Nivel_4 ;
    fiunju:cantidadMinimaRequerida 1 .

