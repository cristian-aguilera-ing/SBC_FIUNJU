@prefix fiunju: <http://fi.unju.edu.ar/ontologia/informatica#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fiunju:ArquetipoEstudiante a rdfs:Class ;
    owl:sameAs fiunju:ArquetipoEstudiante .

fiunju:ExamenMultipleChoice a rdfs:Class ;
    rdfs:label "Examen Multiple Choice"@es ;
    fiunju:tieneDificultadExamen fiunju:ExamenNormal ;
    rdfs:subClassOf fiunju:ModalidadExamenFinal ;
    owl:disjointWith fiunju:ExamenTeoricoEscrito,
        fiunju:ExamenTeoricoOral ;
    owl:sameAs fiunju:ExamenMultipleChoice .

fiunju:ExamenTeoricoEscrito a rdfs:Class ;
    rdfs:label "Examen Teórico Escrito"@es ;
    fiunju:tieneDificultadExamen fiunju:ExamenDificil ;
    rdfs:subClassOf fiunju:ModalidadExamenFinal ;
    owl:disjointWith fiunju:ExamenTeoricoOral ;
    owl:sameAs fiunju:ExamenTeoricoEscrito .

fiunju:ExamenTeoricoOral a rdfs:Class ;
    rdfs:label "Examen Teórico Oral"@es ;
    fiunju:tieneDificultadExamen fiunju:ExamenMuyDificil ;
    rdfs:subClassOf fiunju:ModalidadExamenFinal ;
    owl:sameAs fiunju:ExamenTeoricoOral .

fiunju:FactorAcademico a rdfs:Class ;
    owl:sameAs fiunju:FactorAcademico .

fiunju:FactorMentalidad a rdfs:Class ;
    owl:sameAs fiunju:FactorMentalidad .

fiunju:FactorPersonal a rdfs:Class ;
    owl:sameAs fiunju:FactorPersonal .

fiunju:FactorPlanificacion a rdfs:Class ;
    owl:sameAs fiunju:FactorPlanificacion .

fiunju:Materia a rdfs:Class ;
    owl:sameAs fiunju:Materia .

fiunju:ModalidadExamenFinal a rdfs:Class ;
    owl:sameAs fiunju:ModalidadExamenFinal .

fiunju:NivelDificultadCursada a rdfs:Class ;
    owl:sameAs fiunju:NivelDificultadCursada .

fiunju:NivelDificultadExamen a rdfs:Class ;
    owl:sameAs fiunju:NivelDificultadExamen .

fiunju:TopicoDeConsejo a rdfs:Class ;
    owl:sameAs fiunju:TopicoDeConsejo .

fiunju:ArquetipoEquilibrado a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "green"^^xsd:string ;
    fiunju:tieneNombreArquetipo "El Equilibrado"@es ;
    owl:sameAs fiunju:ArquetipoEquilibrado .

fiunju:ArquetipoErmitano a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "blue"^^xsd:string ;
    fiunju:tieneNombreArquetipo "El Ermitaño del Interior"@es ;
    owl:sameAs fiunju:ArquetipoErmitano .

fiunju:ArquetipoGuerrero a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "yellow"^^xsd:string ;
    fiunju:tieneNombreArquetipo "El Guerrero Solitario"@es ;
    owl:sameAs fiunju:ArquetipoGuerrero .

fiunju:ArquetipoHeredero a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "violet"^^xsd:string ;
    fiunju:tieneNombreArquetipo "El Heredero del Trono"@es ;
    owl:sameAs fiunju:ArquetipoHeredero .

fiunju:ArquetipoMalabarista a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "orange"^^xsd:string ;
    fiunju:tieneNombreArquetipo "El Malabarista Urbano"@es ;
    owl:sameAs fiunju:ArquetipoMalabarista .

fiunju:ArquetipoPadreFullTime a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "brown"^^xsd:string ;
    fiunju:tieneConsejoBase "Cursa en el turno opuesto al colegio de tus hijos. Es tu ventana de oro de productividad."@es ;
    fiunju:tieneNombreArquetipo "El Padre/Madre Full-Time"@es ;
    owl:sameAs fiunju:ArquetipoPadreFullTime .

fiunju:ArquetipoSuperviviente a fiunju:ArquetipoEstudiante ;
    fiunju:tieneColorIdentificativo "red"^^xsd:string ;
    fiunju:tieneConsejoBase "Debido a tus tiempos, usa el Método Pomodoro Corto (sesiones de 25 min) ya que no tendrás bloques largos libres."@es ;
    fiunju:tieneNombreArquetipo "El Superviviente"@es ;
    owl:sameAs fiunju:ArquetipoSuperviviente .

fiunju:ExamenFacil a fiunju:NivelDificultadExamen ;
    rdfs:label "Fácil"@es ;
    fiunju:tieneValor 1 ;
    owl:sameAs fiunju:ExamenFacil .

fiunju:FA_ColegioSecundario a fiunju:FactorAcademico ;
    rdfs:label "Colegio Secundario (Técnica vs. Bachiller)"@es ;
    fiunju:tienePrioridad 3 ;
    owl:sameAs fiunju:FA_ColegioSecundario .

fiunju:FA_HabitoEstudio a fiunju:FactorAcademico ;
    rdfs:label "Hábito de Estudio (constante vs. último momento)"@es ;
    fiunju:tienePrioridad 1 ;
    owl:sameAs fiunju:FA_HabitoEstudio .

fiunju:FA_MetodoEstudio a fiunju:FactorAcademico ;
    rdfs:label "Método de Estudio (solo vs. grupo, leer vs. escuchar)"@es ;
    fiunju:tienePrioridad 2 ;
    owl:sameAs fiunju:FA_MetodoEstudio .

fiunju:FP_LugarResidencia a fiunju:FactorPersonal ;
    rdfs:label "Lugar de Residencia (Interior vs. Capital)"@es ;
    fiunju:tienePrioridad 4 ;
    owl:sameAs fiunju:FP_LugarResidencia .

fiunju:FP_SituacionHogar a fiunju:FactorPersonal ;
    rdfs:label "Situación de Hogar (vive solo, tiene hijos)"@es ;
    fiunju:tienePrioridad 2 ;
    owl:sameAs fiunju:FP_SituacionHogar .

fiunju:FP_TipoTrabajo a fiunju:FactorPersonal ;
    rdfs:label "El trabajo está relacionado con la informática"@es ;
    fiunju:tienePrioridad 3 ;
    owl:sameAs fiunju:FP_TipoTrabajo .

fiunju:FP_Trabaja a fiunju:FactorPersonal ;
    rdfs:label "Trabaja"@es ;
    fiunju:tienePrioridad 1 ;
    owl:sameAs fiunju:FP_Trabaja .

fiunju:IntInnEntrep a fiunju:Materia,
        fiunju:Optativa ;
    rdfs:label "Introducción a la Innovación y Entrepreneurship"@es ;
    fiunju:otorgaCreditos 90 ;
    fiunju:tieneDificultadCursada fiunju:Nivel_1 ;
    owl:sameAs fiunju:IntInnEntrep .

fiunju:ModProNeg a fiunju:Materia,
        fiunju:Optativa ;
    rdfs:label "Modelado y Proceso de Negocios"@es ;
    fiunju:otorgaCreditos 90 ;
    fiunju:tieneDificultadCursada fiunju:Nivel_1 ;
    fiunju:tieneModalidadExamen fiunju:ExamenTeoricoEscrito,
        fiunju:ExamenTeoricoOral ;
    owl:sameAs fiunju:ModProNeg .

fiunju:PPS a fiunju:Materia,
        fiunju:Obligatoria ;
    rdfs:label "Practica Profesional Supervisada"@es ;
    fiunju:perteneceAlAño 5 ;
    fiunju:requiereCreditos 270 ;
    fiunju:requiereCuartoAnoAprobado true ;
    owl:sameAs fiunju:PPS .

fiunju:TIC a fiunju:Materia,
        fiunju:Obligatoria ;
    rdfs:label "Teoría de la Información y la Comunicación"@es ;
    fiunju:perteneceAlAño 2 ;
    fiunju:tieneDificultadCursada fiunju:Nivel_1 ;
    fiunju:tieneModalidadExamen fiunju:ExamenTeoricoOral ;
    owl:sameAs fiunju:TIC .

fiunju:TopicoExamenEscrito a fiunju:TopicoDeConsejo ;
    rdfs:label "Preparación para Examen Escrito"@es ;
    owl:sameAs fiunju:TopicoExamenEscrito .

fiunju:tienePrioridad owl:sameAs fiunju:tienePrioridad .

