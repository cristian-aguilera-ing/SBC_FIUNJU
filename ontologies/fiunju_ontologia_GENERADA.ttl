    owl:sameAs fiunju:tieneTopicoRelevante .

fiunju:tieneValor a owl:DatatypeProperty ;
    rdfs:subPropertyOf fiunju:tieneValor ;
    owl:equivalentProperty fiunju:tieneValor ;
    owl:sameAs fiunju:tieneValor .

xsd:boolean a rdfs:Datatype ;
    owl:disjointWith xsd:decimal,
        xsd:string ;
    owl:sameAs xsd:boolean .

owl:Class owl:sameAs owl:Class .

owl:FunctionalProperty owl:sameAs owl:FunctionalProperty .

owl:Nothing a owl:Class ;
    rdfs:subClassOf owl:Nothing,
        owl:Thing ;
    owl:equivalentClass owl:Nothing ;
    owl:sameAs owl:Nothing .

owl:TransitiveProperty owl:sameAs owl:TransitiveProperty .

"Difícil"@es owl:sameAs "Difícil"@es .

"Fácil"@es owl:sameAs "Fácil"@es .

"Normal"@es owl:sameAs "Normal"@es .

